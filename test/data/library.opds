<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test library of four books, read by Manager::readFile() (see
  Book::updateFromOpds() in src/book.cpp for how each element is read):
    <id>urn:uuid:ID</id>     -> the book id ("urn:uuid:" is stripped)
    acquisition <link>       -> a relative or absolute filesystem href is
                                the local ZIM path (a relative one is
                                resolved against the directory of this
                                file); an absolute URL href is a download
                                URL
    length (on that link)    -> the book size, in bytes
    <dc:issued>              -> the book date, or <updated> if there is no
                                <dc:issued> (only the first 10 chars, i.e.
                                YYYY-MM-DD, are kept)
    <author>/<publisher>     -> creator/publisher, via their <name>
    <kiwix:titleid>          -> the title ID, shared by all the releases
                                of a book
    <kiwix:popularity>       -> the book popularity (0..100), unknown if
                                missing or invalid
    <kiwix:zimdigests>       -> the digests of the ZIM file, one
                                <kiwix:zimdigest type="TYPE"> per digest
                                type (md5, sha1 or sha256)
    thumbnail <link>         -> the illustration: its href is a URL to the
                                image (or a "data:" URI embedding it), and
                                its type gives the mime type and size
-->
<feed xmlns="http://www.w3.org/2005/Atom"
      xmlns:kiwix="https://kiwix.org/namespace/opds"
      xmlns:opds="https://specs.opds.io/opds-1.2">
  <id>7f8a2b1e-0000-4000-8000-000000000000</id>
