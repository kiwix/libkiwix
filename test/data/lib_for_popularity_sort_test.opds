<?xml version="1.0" encoding="UTF-8"?>
<!--
  Library whose books are not ordered by popularity (a book without
  <kiwix:popularity> is considered to have an average popularity of 50).
  It contains no ZIM files, hence must be served in catalog only mode.
-->
