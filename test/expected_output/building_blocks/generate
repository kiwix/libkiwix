mydir = os.path.dirname(__file__)

def gen_openaccess_link(link_kind, filename, size):
    https_url_prefix = 'https://github.com/kiwix/libkiwix/raw/master/test/data/'
    if link_kind == 'DIRECT':
        mimetype = 'application/x-zim'
        url =  https_url_prefix + filename + '.zim'
    elif link_kind == 'META4':
        mimetype = 'application/metalink4+xml'
        url =  https_url_prefix + filename + '.zim.meta4'
    elif link_kind == 'BITTORRENT':
        mimetype = 'application/x-bittorrent'
        url =  https_url_prefix + filename + '.zim.torrent'
    elif link_kind == 'MAGNET':
        mimetype = 'application/x-magnet'
        url = f"magnet:?xt=urn:md5:md5sum-of-{filename}.zim&amp;xl={size}&amp;dn={filename}.zim"

    return f'''
    <link rel="http://opds-spec.org/acquisition/open-access" type="{mimetype}" href="{url}" length="{size}" />'''

def openaccess_links_opds(data):
    size = data['SIZE']
    filename = urlencode(data['FILENAME'])
    link_kinds = data['OPENACCESSLINKKINDS']
    if data['OPDS_VARIANT'] == 'catalog/v2':
        link_kinds = link_kinds[-1:]
    gen_link_block = lambda k: gen_openaccess_link(k, filename, size)
    return "".join([gen_link_block(k) for k in link_kinds])

def illustration_links_opds(data):
    uuid = data['UUID']
    opds_variant = data['OPDS_VARIANT']
    def gen_link_block(illustration_info):
        illustration_info = edict(illustration_info,
                                  OPDS_VARIANT=opds_variant,
                                  UUID=uuid)
        if opds_variant != "library":
            illustration_info['URL'] = '/ROOT%23%3F/{OPDS_VARIANT}/illustration/{UUID}/?size={SIZE}'.format(**illustration_info)
        link_template="""
    <link rel="http://opds-spec.org/image/thumbnail"
          href="{URL}"
          type="image/png;width={SIZE};height={SIZE};scale=1"/>"""
        return link_template.format(**illustration_info)

    return "".join([gen_link_block(i) for i in data['ILLUSTRATIONS']])

def preview_link_opds(data):
    opds_variant = data['OPDS_VARIANT']
    if opds_variant == "library":
        return ""

    contentid = data['CONTENTID']
    return f'''
    <link type="text/html" href="/ROOT%23%3F/content/{contentid}" />'''

def zimfile_link_opds(data):
    opds_variant = data['OPDS_VARIANT']
    if opds_variant != "library":
        return ""

    filename = html.escape(data['FILENAME'])
    size = data['SIZE']
    return f'''
    <link rel="http://opds-spec.org/acquisition/open-access" href="{filename}.zim" type="application/x-zim" length="{size}"/>'''

def popularity_opds(data):
    popularity = data.get('POPULARITY')
    # catalog/v2 entries are frozen and never expose the popularity
    if popularity is None or data['OPDS_VARIANT'] == 'catalog/v2':
        return ""

    return f'''
    <kiwix:popularity>{popularity}</kiwix:popularity>'''

def digests_opds(data):
    digests = data.get('DIGESTS')
    # catalog/v2 entries are frozen and never expose the digests
    if not digests or data['OPDS_VARIANT'] == 'catalog/v2':
        return ""

    result = '\n    <kiwix:zimdigests>'
    # Digests are rendered in the order of the kiwix::Book::DigestType enumerators
    for digest_type in ('md5', 'sha1', 'sha256'):
        if digest_type not in digests:
            continue
        value = digests[digest_type]
        result += f'\n      <kiwix:zimdigest type="{digest_type}">{value}</kiwix:zimdigest>'
    return result + '\n    </kiwix:zimdigests>'

def generate_opds_entry_building_block(identifier, data):
    data['POPULARITY'] = popularity_opds(data)
    data['DIGESTS'] = digests_opds(data)
    data['PREVIEWLINK'] = preview_link_opds(data)
    data['ILLUSTRATIONLINKS'] = illustration_links_opds(data)
    data['OPENACCESSLINKS']   = openaccess_links_opds(data)
    data['ZIMFILELINK']   = zimfile_link_opds(data)
    return OPDS_ENTRY_TEMPLATE.format(ID=identifier, **data);

def write_file(path, content):
    path = os.path.join(mydir, path)
    with open(path, "w") as outfile:
        outfile.write(content)

def write_opds_entry_building_block(opds_variant, fname, identifier, data):
    path = "opds/" + opds_variant + "/" + fname
    data = edict(data, OPDS_VARIANT=opds_variant)
    content = generate_opds_entry_building_block(identifier, data);
    write_file(path, content)

def edict(d, **u):
    "Returns an edited copy of the input dict"
    d = d.copy()
    d.update(u)
    return d

