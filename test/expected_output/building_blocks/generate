import os

OPDS_ENTRY_TEMPLATE = """// DO NOT EDIT THIS FILE. INSTEAD UPDATE AND RERUN
// THE SCRIPT test/expected_output/building_blocks/generate.

DEFINE_EXPECTED_OUTPUT({MACRONAME},
R"(  <entry>
    <id>urn:uuid:{UUID}</id>
    <title>{TITLE}</title>
    <updated>YYYY-MM-DDThh:mm:ssZ</updated>
    <summary>{SUMMARY}</summary>
    <language>{LANG}</language>
    <name>{NAME}</name>
    <flavour>{FLAVOUR}</flavour>
    <category>{CATEGORY}</category>
    <tags>{TAGS}</tags>
    <articleCount>{ARTICLECOUNT}</articleCount>
    <mediaCount>{MEDIACOUNT}</mediaCount>{ILLUSTRATIONLINKS}
    <link type="text/html" href="/ROOT%23%3F/content/{CONTENTID}" />
    <author>
      <name>{AUTHOR}</name>
    </author>
    <publisher>
      <name>{PUBLISHER}</name>
    </publisher>
    <dc:issued>{ISSUED}</dc:issued>
    <link rel="http://opds-spec.org/acquisition/open-access" type="application/x-zim" href="https://github.com/kiwix/libkiwix/raw/master/test/data/{FILENAME}.zim" length="{SIZE}" />
  </entry>
)");
"""

mydir = os.path.dirname(__file__)

def illustration_links_opds(data):
    uuid = data['UUID']
    def gen_link_block(illustration_info):
        illustration_info = edict(illustration_info, UUID=uuid)
        link_template="""
    <link rel="http://opds-spec.org/image/thumbnail"
          href="/ROOT%23%3F/catalog/v2/illustration/{UUID}/?size={SIZE}"
          type="image/png;width={SIZE};height={SIZE};scale=1"/>"""
        return link_template.format(**illustration_info)

    return "".join([gen_link_block(i) for i in data['ILLUSTRATIONS']])

def generate_opds_entry_building_block(macroname, data):
    data['ILLUSTRATIONLINKS'] = illustration_links_opds(data)
    return OPDS_ENTRY_TEMPLATE.format(MACRONAME=macroname, **data);

def write_opds_entry_building_block(path, macroname, data):
    path = os.path.join(mydir, path)
    with open(path, "w") as outfile:
        outfile.write(generate_opds_entry_building_block(macroname, data))

def edict(d, **u):
    "Returns an edited copy of the input dict"
    d = d.copy()
    d.update(u)
    return d

